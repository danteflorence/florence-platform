{
  "name": "florence-education-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Florence Education / Florence OS monorepo skeleton and CI contract.",
  "packageManager": "npm@11.13.0",
  "scripts": {
    "setup:local": "node scripts/local/setup.mjs",
    "dev": "docker compose --env-file .env.local up --build",
    "dev:core": "docker compose --env-file .env.local up --build postgres core-api",
    "dev:academy": "docker compose --env-file .env.local up --build postgres core-api academy-api academy-live app-web",
    "dev:pathway": "docker compose --env-file .env.local up --build postgres core-api pathway-api",
    "dev:employer": "docker compose --env-file .env.local up --build postgres core-api economist-api employer-connect-api",
    "dev:economist": "docker compose --env-file .env.local up --build economist-api",
    "db:migrate": "node scripts/local/compose-task.mjs migrate",
    "db:seed": "node scripts/local/compose-task.mjs seed",
    "smoke:local": "node scripts/local/smoke.mjs",
    "dev:help": "node scripts/ci/dev-help.mjs",
    "ci:install": "node scripts/ci/run-npm.mjs install",
    "typecheck": "node scripts/ci/run-npm.mjs typecheck",
    "workspace:check": "node scripts/ci/check-workspace-skeleton.mjs",
    "database:check": "node scripts/ci/check-database-standard.mjs",
    "database:compose": "node scripts/ci/verify-docker-postgres.mjs",
    "migration:dry-run": "node scripts/deploy/migration-dry-run.mjs",
    "test": "node scripts/ci/run-npm.mjs test",
    "lint": "node scripts/ci/lint-workspace.mjs",
    "prettier": "node scripts/ci/prettier-check.mjs",
    "build": "node scripts/ci/run-npm.mjs build",
    "clean": "node scripts/ci/clean-artifacts.mjs",
    "security:secrets": "node scripts/security/scan-secrets.mjs",
    "security:secrets:test": "node scripts/security/test-secret-scanner.mjs",
    "security:deps": "node scripts/security/npm-audit.mjs",
    "security:audit": "node scripts/security/npm-audit.mjs",
    "security:ci:test": "node scripts/security/check-ci-workflow.mjs",
    "security:static": "node scripts/security/static-analysis.mjs",
    "security:test": "node scripts/security/test-secret-scanner.mjs && node scripts/security/check-ci-workflow.mjs",
    "ci": "npm run workspace:check && npm run database:check && npm run ci:install && npm run typecheck && npm test && npm run lint && npm run prettier && npm run build && npm run security:secrets && npm run security:secrets:test && npm run security:audit && npm run security:static && npm run security:ci:test"
  },
  "engines": {
    "node": ">=24"
  }
}
