# Florence Education test stack — TLS termination + per-subdomain reverse proxy.
# Caddy fetches a Let's Encrypt cert for each host automatically (ports 80+443
# must be reachable and DNS must point at this server). BASE_DOMAIN + ACME_EMAIL
# come from the environment (docker-compose passes them in).
{
	email {$ACME_EMAIL}
}

# Identity service
auth.{$BASE_DOMAIN} {
	reverse_proxy core:8080
}

# Florence OS unified app shell + Academy live classroom Socket.IO.
app.{$BASE_DOMAIN} {
	handle_path /pathway-api/* {
		reverse_proxy pathway:8787
	}
	handle_path /employer-api/* {
		reverse_proxy ats:8788
	}
	handle /socket.io/* {
		reverse_proxy academy-live:5179
	}
	handle {
		reverse_proxy app-web:80
	}
}
api.{$BASE_DOMAIN} {
	reverse_proxy academy-api:8088
}
developers.{$BASE_DOMAIN} {
	reverse_proxy core:8080
}

partners.{$BASE_DOMAIN} {
	reverse_proxy ats:8788
}

# Pathway and Workforce Economist remain local-only services until routed under
# the canonical Florence OS app surface.
