# Florence Education local development template.
# Copy to .env.local with `pnpm setup:local`. Values here are fake local defaults.

COMPOSE_PROJECT_NAME=florence-local

POSTGRES_PORT=5432
POSTGRES_USER=florence
POSTGRES_PASSWORD=changeme

CORE_API_PORT=8080
ACADEMY_API_PORT=18088
ACADEMY_LIVE_PORT=5179
APP_WEB_PORT=5174
PATHWAY_API_PORT=8787
EMPLOYER_CONNECT_API_PORT=8788
ECONOMIST_API_PORT=8094

PUBLIC_CORE_URL=http://localhost:8080
CORE_ISSUER_URL=http://core-api:8080
PUBLIC_APP_URL=http://localhost:5174
TOKEN_ISS=florence-auth
TOKEN_AUD=florence
COOKIE_DOMAIN=
COOKIE_SECURE=0
FLORENCE_ALLOWED_DOMAIN=florenceedu.com,example.invalid
FLORENCE_REDIRECT_HOSTS=localhost,127.0.0.1,.lvh.me,.florenceedu.com

CORE_BOOTSTRAP_ADMIN_EMAIL=local-admin@example.invalid
CORE_BOOTSTRAP_ADMIN_PASSWORD=changeme

FIELD_ENC_PASSPHRASE=changeme
DEMO_CLIENT_SECRET=changeme
WEBHOOK_SECRET=changeme
API_JWT_SECRET=changeme
ATS_CONNECT_VAULT_KEY=changeme
ATS_WEBHOOK_SECRET=changeme

APP_CORE_URL=http://localhost:8080
APP_ACADEMY_API_URL=http://localhost:18088
APP_PATHWAY_API_URL=http://localhost:8787/api
APP_EMPLOYER_CONNECT_API_URL=http://localhost:8788/api
APP_LIVE_URL=http://localhost:5179
APP_APPLY_URL=https://www.florenceedu.com/apply

ALLOW_SYNTHETIC_SEED=0
STATUS_SYNC_INTERVAL_MS=0
PRICING_API_URL=http://economist-api:8094
