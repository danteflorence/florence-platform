# Florence Pathway Agent — environment

# Optional. When set, AI-assisted explanations, deficiency classification, and
# QA narratives route through Florence Core's Model Gateway. When unset, the app
# runs fully on the deterministic/heuristic provider - no model-provider key is
# required in Pathway.
CORE_MODEL_GATEWAY_URL=
CORE_MODEL_GATEWAY_TOKEN=

# API server port (Vite proxies /api here).
PORT=8787

# Production/default persistence. Required outside explicit local throwaway mode.
DATABASE_URL=postgres://florence:placeholder@localhost:5432/florence_pathway
PATHWAY_DB=postgres

# Local throwaway development only. Do not set in production.
ALLOW_SQLITE_LOCAL_DEV=

# Optional webhook that receives FlorenceRN production-ledger milestone events.
# When unset, milestones are recorded locally and logged.
FLORENCE_LEDGER_WEBHOOK=

# Optional webhook for proactive candidate reminders (wire to your email/SMS/WhatsApp
# provider, e.g. Postmark/Twilio). When unset, reminders are computed and logged only.
FLORENCE_NOTIFY_WEBHOOK=
