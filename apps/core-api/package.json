{
  "name": "@florence/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Florence OS Core — the central identity / SSO service. Issues one RS256 token verified everywhere via JWKS carrying a unified role and identity, so Academy, Pathway, ATS Connect, and Workforce Economist become surfaces of one platform.",
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "migrate": "node db/migrate.mjs",
    "seed-admin": "node scripts/seed-admin.ts",
    "seed-app-clients": "node scripts/seed-app-clients.ts",
    "verify-spine": "node scripts/verify-spine.ts",
    "verify-audit": "node scripts/verify-audit.ts",
    "verify-security": "node scripts/verify-security-spine.ts",
    "verify-logging-telemetry-audit": "node scripts/verify-logging-telemetry-audit.ts",
    "verify-model-gateway": "node scripts/verify-model-gateway.ts",
    "verify-document-vault": "node scripts/verify-document-vault.ts",
    "verify-logging-audit": "node scripts/verify-logging-audit.ts",
    "verify-application-gate": "node scripts/verify-application-gate.ts",
    "verify-control-tower": "node scripts/verify-control-tower.ts",
    "verify-retention": "node scripts/verify-retention.ts",
    "verify-onboarding-risk": "node scripts/verify-onboarding-risk.ts",
    "verify-university-investor": "node scripts/verify-university-investor.ts",
    "verify-gateway": "node scripts/verify-gateway.ts",
    "verify-lender": "node scripts/verify-lender.ts",
    "verify-tenant-binding": "node scripts/verify-tenant-binding.ts",
    "verify-candidate-auth": "node scripts/verify-candidate-auth.ts",
    "verify-tenant-isolation": "node scripts/verify-tenant-isolation.ts",
    "rotate-key": "node scripts/rotate-key.ts",
    "checkpoint": "node scripts/mint-test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run verify-security && npm run verify-logging-telemetry-audit && npm run verify-model-gateway && npm run verify-document-vault && npm run verify-application-gate && npm run verify-audit && npm run verify-control-tower && npm run verify-gateway && npm run verify-lender && npm run verify-tenant-binding && npm run verify-tenant-isolation && npm run verify-candidate-auth",
    "lint": "npm run typecheck",
    "clean": "node ../../scripts/ci/clean-artifacts.mjs ."
  },
  "optionalDependencies": {
    "pg": "^8.13.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "typescript": "^5.6.2"
  }
}
