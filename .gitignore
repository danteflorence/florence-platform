# ── deps + build artifacts ───────────────────────────────────────────────────
**/node_modules/
**/dist/
**/build/
**/.vite/
**/.cache/
**/.cache
**/.turbo/
**/.parcel-cache/
**/.next/
**/.next
**/out/
coverage/

# ── local data + sqlite (never commit databases) ─────────────────────────────
**/data/
# …but src/data/ is SOURCE CODE (question banks, caseBank, blueprint, lesson
# files in academy-web), not local data. Without this negation, the apps/
# restructure would silently drop the entire bank from the repo.
!**/src/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.wal
*.shm

# ── secrets / local env - commit ONLY *.example templates ────────────────────
**/.env
**/.en
**/.env.*
!**/.env.example
!**/.env.*.example
!**/.env.SAFETY_NOTICE.md
!.env.example
!.env.testserver.example
**/.env.local
**/.env.*.local
**/.env.development
**/.env.production
**/.env.staging
**/.env.sandbox
**/.auth_secret
*.pem
*.key
*.p8
*.p12
*.pfx
*-key.json
service-account*.json
**/secrets/

# ── local archives / generated bundles ──────────────────────────────────────
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.dmg

# ── temp / caches ───────────────────────────────────────────────────────────
.cache/
tmp/
temp/
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── generated media ─────────────────────────────────────────────────────────
**/generated-media/
**/generated_media/
**/generated-audio/
**/generated_audio/
**/recordings/
**/replays/
**/data/audio/
**/public/audio/generated/
**/media/generated/
*.generated.mp3
*.generated.wav
*.generated.m4a
*.generated.mp4
*.generated.webm

# ── excluded trees ───────────────────────────────────────────────────────────
# Local Node 24 toolchain (194M, machine-local), the orphaned extracted/ platforms
# (contain their own .env), and the Workforce Economist (its OWN GitHub repo).
.toolchain/
extracted/
labor-economics-agent/

# ── os / editor ──────────────────────────────────────────────────────────────
.DS_Store
*.log
.idea/
.vscode/
*.tsbuildinfo

# internal session/workflow stash
.florence_workflow_stash

# ── terraform ────────────────────────────────────────────────────────────────
# Keep .terraform.lock.hcl committed (provider version lock); exclude the local
# plugin cache + any state (state lives in a remote backend, never in git).
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars.local
